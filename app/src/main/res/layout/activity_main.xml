<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/backgroundColor"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WAVE TRACE"
            android:textColor="@color/accentColor"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:maxLines="1"
            android:gravity="center_vertical"
             />

        <ImageButton
            android:id="@+id/muteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_volume_up_24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mute signal tones"
            android:padding="8dp"
            />

        <ImageButton
            android:id="@+id/scanButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_scan_24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Scan and select a network"
            android:padding="8dp"
            />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_settings_amber_24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:padding="8dp"
            />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/accentDim"
        android:layout_marginBottom="16dp" />

    <!-- Network List View (initially hidden) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/networkRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <!-- Main Content (Signal Display and Graph) -->
    <LinearLayout
        android:id="@+id/mainContentLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Current Network Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/vitals_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/ssidText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SCANNING..."
                android:textColor="@color/accentColor"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/rssiText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-- dBm"
                android:textColor="@color/vitalsStable"
                android:textSize="48sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INITIALIZING..."
                android:textColor="@color/accentDim"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:gravity="center" />
        </LinearLayout>

        <!-- Signal Graph -->
        <com.ruthlessmallard.wavetrace.SignalGraphView
            android:id="@+id/signalGraph"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/vitals_card"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

    <!-- Details Grid -->
    <GridLayout
        android:id="@+id/detailsGridLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:background="@drawable/vitals_card"
        android:padding="16dp"
        android:visibility="visible">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="BSSID"
            android:textColor="@color/accentDim"
            android:textSize="12sp"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/bssidText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="--"
            android:textColor="@color/accentColor"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:gravity="end" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="FREQUENCY"
            android:textColor="@color/accentDim"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/frequencyText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="-- MHz"
            android:textColor="@color/accentColor"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:gravity="end"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="LINK SPEED"
            android:textColor="@color/accentDim"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/linkSpeedText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="-- Mbps"
            android:textColor="@color/accentColor"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:gravity="end"
            android:layout_marginTop="8dp" />

    </GridLayout>

</LinearLayout>
